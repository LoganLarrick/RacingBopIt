#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1305.h>
#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BNO055.h>
#include <utility/imumaths.h>
#include <DFRobotDFPlayerMini.h>

const uint8_t gas_pedal    = A0;
const uint8_t brake_pedal  = A1;
const uint8_t clutch_pedal = A2;

const uint8_t shift_up   = 12;   //pin 18
const uint8_t shift_down = 13;   // pin 19

const uint8_t buzzer = 14;       // 20 
const uint8_t BUZZ_IDLE = 128;   
const uint8_t BUZZ_GAS  = 255;   

DFRobotDFPlayerMini myDFPlayer;
bool audioOK = false;

const uint8_t SND_GO    = 1;
const uint8_t SND_ZOOM  = 2;
const uint8_t SND_CRASH = 3;
const uint8_t SND_WIN   = 4;

#define OLED_CS      4   // 5
#define OLED_DC      3   //pin 4
#define OLED_RESET   2   // 3
#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64

#define STEER_SIGN -1
#define STEER_THRESHOLD 30.0

Adafruit_BNO055 bno = Adafruit_BNO055(55);

Adafruit_SSD1305 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &SPI,
  OLED_DC,
  OLED_RESET,
  OLED_CS,
  4000000UL
);

bool correct = true;
int score = 0, rand_select;
int time_limit, timer = 0;
int high_score = 0;
float steerZero = 0;
float steer = 0;

bool action_select[6] = {false, false, false, false, false, false};

void updateBuzzer() {
  analogWrite(buzzer, digitalRead(gas_pedal) == HIGH ? BUZZ_GAS : BUZZ_IDLE);
}

// Like delay(), but keeps the buzzer level following the gas pedal
void buzzDelay(unsigned long ms) {
  unsigned long start = millis();
  while (millis() - start < ms) {
    updateBuzzer();
    delay(1);
  }
}

void playSound(uint8_t track) {
  if (audioOK) myDFPlayer.play(track);
}

void showText(const __FlashStringHelper* line1, const __FlashStringHelper* line2 = nullptr) {
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.println(line1);
  if (line2) display.println(line2);
  display.display();
}

void showScore(const __FlashStringHelper* title) {
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.println(title);
  display.print(F("RACES WON: "));
  display.println(score);
  display.print(F("Best: "));
  display.println(high_score);
  display.display();
}

float readRawX() {
  sensors_event_t event;
  bno.getEvent(&event);
  return event.orientation.x;
}

void readSteer() {
  steer = (readRawX() - steerZero) * STEER_SIGN;
  while (steer > 180) steer -= 360;
  while (steer < -180) steer += 360;
}

// funcs for determinng action
bool steerLeft()  { return steer >  STEER_THRESHOLD; }
bool steerRight() { return steer < -STEER_THRESHOLD; }

bool shiftUpActive() {
  return digitalRead(shift_up) == LOW && digitalRead(shift_down) == HIGH;
}

bool shiftDownActive() {
  return digitalRead(shift_down) == LOW && digitalRead(shift_up) == HIGH;
}

bool checkShifter() {
  return shiftUpActive() || shiftDownActive();
}

bool checkInputs() {
  updateBuzzer();
  readSteer();
  if (digitalRead(gas_pedal) == HIGH)    return true;
  if (digitalRead(clutch_pedal) == HIGH) return true;
  if (digitalRead(brake_pedal) == HIGH)  return true;
  if (checkShifter())                    return true;
  if (steerLeft() || steerRight())       return true;
  return false;
}

// wait b4 moving on
void waitForRelease() {
  while (checkInputs()) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor(0, 0);
    display.println(F("RELEASE:"));
    if (digitalRead(gas_pedal) == HIGH)    display.println(F("gas"));
    if (digitalRead(clutch_pedal) == HIGH) display.println(F("clutch"));
    if (digitalRead(brake_pedal) == HIGH)  display.println(F("brake"));
    if (shiftUpActive())                   display.println(F("shift up"));
    if (shiftDownActive())                 display.println(F("shift down"));
    if (steerLeft() || steerRight()) {
      display.print(F("steer "));
      display.println(steer, 1);
    }
    display.display();
    delay(50);
  }
}

void setup() {
  Wire.begin();
#if defined(WIRE_HAS_TIMEOUT)
  Wire.setWireTimeout(3000, true);
#endif

  if (!display.begin(0x3C)) {
    while (true) delay(100);
  }

  if (!bno.begin(OPERATION_MODE_IMUPLUS)) {
    showText(F("NO BNO055"));
    while (1);
  }
  delay(100);
  bno.setExtCrystalUse(true);
  delay(100);

  Serial1.begin(9600);
  delay(1000);
  if (myDFPlayer.begin(Serial1)) {
    audioOK = true;
    myDFPlayer.setTimeOut(500);
    myDFPlayer.volume(20);
    myDFPlayer.EQ(DFPLAYER_EQ_NORMAL);
    myDFPlayer.outputDevice(DFPLAYER_DEVICE_SD);
  }

  pinMode(clutch_pedal, INPUT);
  pinMode(brake_pedal, INPUT);
  pinMode(gas_pedal, INPUT);
  pinMode(shift_up, INPUT_PULLUP);
  pinMode(shift_down, INPUT_PULLUP);

  pinMode(buzzer, OUTPUT);
  analogWrite(buzzer, BUZZ_IDLE);

  randomSeed(analogRead(A3));
}

//game
void loop() {

  showText(F("PRESS GAS"), F("TO START"));

  while (digitalRead(gas_pedal) == LOW) {
    updateBuzzer();
    delay(1);
  }

  score = -1;
  correct = true;
  time_limit = 5500;
  timer = 0;

  showText(F("GET READY"));
  buzzDelay(1000);
  showText(F("3"));
  buzzDelay(1000);
  showText(F("2"));
  buzzDelay(1000);
  showText(F("1"));
  buzzDelay(1000);

  steerZero = readRawX();
  steer = 0;

  showText(F("GO!"));
  playSound(SND_GO);
  buzzDelay(500);

  waitForRelease();

  while (correct) {
    score++;
    timer = 0;

    for (int i = 0; i < 6; i++) {
      action_select[i] = false;
    }

    rand_select = random(0, 6);
    action_select[rand_select] = true;

    switch (rand_select) {
      case 0:
        showText(F("GAS!"));
        break;
      case 1:
        showText(F("BRAKE!"));
        break;
      case 2:
        showText(F("STEER"), F("LEFT!"));
        break;
      case 3:
        showText(F("STEER"), F("RIGHT!"));
        break;
      case 4:
        showText(F("SHIFT"), F("UP!"));
        break;
      case 5:
        showText(F("SHIFT"), F("DOWN!"));
        break;
    }

    while (!checkInputs()) {
      delay(1);
      timer++;
      if (timer >= time_limit) {
        correct = false;
        break;
      }
    }

    if (correct) delay(30);
    readSteer();

    if (correct && digitalRead(gas_pedal) == HIGH) {
      if (!action_select[0]) correct = false;
    }

    if (correct && digitalRead(brake_pedal) == HIGH) {
      if (!action_select[1]) correct = false;
    }

    if (correct && steerLeft()) {
      if (!action_select[2]) correct = false;
    }

    if (correct && steerRight()) {
      if (!action_select[3]) correct = false;
    }

    if (correct && checkShifter() && digitalRead(clutch_pedal) == LOW) {
      correct = false;
    }

    if (correct && digitalRead(clutch_pedal) == HIGH) {

      if (!action_select[4] && !action_select[5]) {
        correct = false;
      }
      else {
        timer -= 500;
        while (!checkShifter()) {
          updateBuzzer();
          delay(1);
          timer++;
          if (timer >= time_limit) {
            correct = false;
            break;
          }
        }

        if (correct) {
          if (shiftUpActive() && !action_select[4]) {
            correct = false;
          } else if (shiftDownActive() && !action_select[5]) {
            correct = false;
          }
        }
      }
    }

    time_limit -= 5;

    if (score == 99 && correct) {
      correct = false;
      score++;
    }

    if (correct) {
      playSound(SND_ZOOM);
      waitForRelease();
      showText(F("ZOOOM!"));
      buzzDelay(500);
    }
  }

  if (score == 100) {
    showText(F("YOU WIN!"));
    playSound(SND_WIN);
  } else {
    showText(F("YOU"), F("CRASHED!"));
    playSound(SND_CRASH);
  }
  buzzDelay(2000);

  if (score > high_score) {
    high_score = score;
  }

  showScore(F("RACE OVER"));
  buzzDelay(4000);

  waitForRelease();
}
